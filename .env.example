# Sri Lanka–France Business Council (SLFBC) Environment Configuration
APP_NAME="Sri Lanka–France Business Council"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.slfbc.lk
APP_SECRET=change-this-to-a-secure-random-32-character-secret-key

# Database Connection (MySQL 8+ / MariaDB for production cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slfbc_portal
DB_USERNAME=slfbc_user
DB_PASSWORD=your_secure_database_password_here

# For zero-setup local dev/testing without MySQL service, set DB_CONNECTION=sqlite:
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite

# Mail Configuration (Ceylon Chamber Secretariat SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=mail.slfbc.lk
MAIL_PORT=587
MAIL_USERNAME=secretariat@slfbc.lk
MAIL_PASSWORD=secretariat_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@slfbc.lk
MAIL_FROM_NAME="SLFBC Secretariat"

# Secretariat Notification Recipients
SECRETARIAT_NOTIFY_EMAIL=slfbc@chamber.lk

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_COOKIE_NAME=slfbc_session
ADMIN_RATE_LIMIT_ATTEMPTS=5
ADMIN_RATE_LIMIT_MINUTES=15
